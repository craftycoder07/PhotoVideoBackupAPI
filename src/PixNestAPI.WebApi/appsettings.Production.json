{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "PixNestAPI": "Information"
      }
    },
    // WriteTo is an ARRAY, and .NET configuration merges arrays by INDEX, not by sink
    // name. All three sinks from appsettings.json must be restated here in the same
    // order — omit one and the base entry survives at that index (e.g. Seq would keep
    // pointing at http://localhost:5341, which does not exist inside the container).
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/pixnest-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} | {Message:lj} | MachineName={MachineName} ThreadId={ThreadId}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:80"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId" ],
    "Properties": {
      "Application": "PixNestAPI",
      "Environment": "Production"
    },
    // ErrorsOnly keeps a home server's disk from filling with a line per request.
    // Flip to false temporarily when debugging proxy or auth behaviour.
    "RequestLogging": {
      "Enabled": true,
      "ErrorsOnly": true
    }
  },
  "StorageSettings": {
    "BasePath": "/app/media",
    "MaxFileSize": 104857600,
    "EnableThumbnails": true,
    "ThumbnailSize": 300,
    "CompressionQuality": 85
  },
  "BackupSettings": {
    "DefaultBackupWindow": {
      "StartTime": "22:00:00",
      "EndTime": "06:00:00"
    },
    "MaxConcurrentSessions": 5,
    "SessionTimeoutMinutes": 30,
    "RetentionDays": 90
  },
  // Apply pending EF Core migrations during startup. Safe here because this is a
  // single-instance deployment — no replicas or rolling deploys to race the migration.
  "Database": {
    "MigrateOnStartup": true
  },
  // THIS FILE IS COMMITTED — no secrets. The connection string and the JWT signing key
  // are supplied at runtime via the ConnectionStrings__DefaultConnection and Jwt__Secret
  // environment variables. Left empty so Program.cs fails fast with a clear message.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "PixNestAPI",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  }
}
